---
/**
 * Seiten-Hero: Text links, seitenspezifisches Foto rechts.
 *
 * Die Original-Headerbanner der Vorlage (Slogan ins Bild eingebacken) sind
 * bewusst ersetzt: Ihre Foto-Teile liegen zugeschnitten als
 * `header-*-foto.jpg` in src/assets und werden hier als echtes Bild neben
 * echtem Text verwendet. Die Slogans laufen — wo sie nicht ohnehin die H1
 * doppeln — als `lead` mit.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import fertigungshalle from '../assets/fertigungshalle.jpg';

interface Props {
  eyebrow: string;
  titel: string;
  lead?: string;
  bild?: string;
  bildAlt?: string;
}

const { eyebrow, titel, lead, bild, bildAlt } = Astro.props;

const alleBilder = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{jpg,jpeg,png}',
  { eager: true }
);

let heroBild: ImageMetadata = fertigungshalle;
if (bild) {
  const treffer = Object.entries(alleBilder).find(
    ([pfad]) => pfad.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '') === bild
  );
  if (!treffer) throw new Error(`Hero-Bild "${bild}" nicht gefunden`);
  heroBild = treffer[1].default;
}
---

<section class="band page-hero">
  <div class="shell page-hero__grid">
    <div class="page-hero__copy">
      <slot name="top" />
      <p class="eyebrow">{eyebrow}</p>
      <h1>{titel}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    <figure class="page-hero__figure">
      <Image
        src={heroBild}
        alt={bildAlt ?? 'Die CNC-Fertigungshalle von Staudt Hydraulik'}
        widths={[480, 720, 980]}
        sizes="(min-width: 60rem) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={80}
        class="page-hero__img"
      />
    </figure>
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(70% 90% at 100% 0%, #dde9f5 0%, transparent 55%),
      linear-gradient(175deg, var(--wash) 0%, var(--paper) 72%);
    padding-block: var(--space-xl);
  }

  .page-hero__grid {
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .page-hero__copy {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .page-hero__figure {
    margin: 0;
  }

  .page-hero :global(.page-hero__img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    width: 100%;
  }

  @media (min-width: 60rem) {
    .page-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .page-hero :global(.page-hero__img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
