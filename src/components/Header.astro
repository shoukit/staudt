---
/**
 * Sticky Header: Logo der Vorlage, Nav, „Anfragen" als primäre Aktion.
 * Unter 64rem Disclosure-Nav — offen ausgeliefert, per Script geschlossen,
 * ohne JavaScript bleibt alles erreichbar.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { contact, nav, site } from '../data/site';
import logo from '../assets/logo.png';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="site-header">
  {/* Kundenwunsch: Kontakt-Button links, Logo rechts. */}
  <div class="site-header__inner">
    <a class="btn btn--primary site-header__cta" href="/kontakt/">
      <Icon name="Mail" size={17} />
      <span>Anfragen</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-controls="hauptnavigation"
      aria-expanded="true"
      hidden
    >
      <span class="nav-toggle__icon" aria-hidden="true">
        <Icon name="Menu" size={22} class="nav-toggle__open" />
        <Icon name="X" size={22} class="nav-toggle__close" />
      </span>
      <span class="visually-hidden nav-toggle__label">Menü öffnen</span>
    </button>

    <nav class="site-nav" id="hauptnavigation" aria-label="Hauptnavigation">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="ChevronRight" size={16} class="site-nav__chevron" />
              </a>
            </li>
          ))
        }
        <li class="site-nav__extra">
          <a href="/suche/">
            Suche
            <Icon name="Search" size={16} class="site-nav__chevron" />
          </a>
        </li>
      </ul>
      <div class="site-nav__kontakt">
        <a href={contact.phoneHref}>
          <Icon name="Phone" size={16} />
          {contact.phone}
        </a>
        <a href={contact.emailHref}>
          <Icon name="Mail" size={16} />
          {contact.email}
        </a>
      </div>
    </nav>

    <a class="suche-link" href="/suche/" aria-label="Website durchsuchen">
      <Icon name="Search" size={19} />
    </a>

    <a class="wordmark" href="/">
      <Image
        src={logo}
        alt={`${site.name} – ${site.claim} – zur Startseite`}
        widths={[180, 360]}
        sizes="180px"
        loading="eager"
        quality={90}
        class="wordmark__img"
      />
    </a>
  </div>
</header>

<script>
  const BREAKPOINT = window.matchMedia('(min-width: 80rem)');
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const label = toggle?.querySelector<HTMLElement>('.nav-toggle__label');
  const navEl = header?.querySelector<HTMLElement>('.site-nav');

  if (header && toggle && label && navEl) {
    const setOpen = (open: boolean) => {
      header.dataset.navOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Menü schließen' : 'Menü öffnen';
    };

    const applyMode = () => {
      if (BREAKPOINT.matches) {
        toggle.hidden = true;
        delete header.dataset.navOpen;
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        toggle.hidden = false;
        if (header.dataset.navOpen === undefined) setOpen(false);
      }
    };

    applyMode();
    BREAKPOINT.addEventListener('change', applyMode);

    toggle.addEventListener('click', () => {
      setOpen(header.dataset.navOpen !== 'true');
    });

    navEl.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a') && !BREAKPOINT.matches) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || header.dataset.navOpen !== 'true') return;
      setOpen(false);
      toggle.focus();
    });

    document.addEventListener('click', (e) => {
      if (header.dataset.navOpen !== 'true') return;
      if (header.contains(e.target as Node)) return;
      setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(12px) saturate(1.1);
    border-bottom: 1px solid var(--line);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--paper);
    }
  }

  .site-header__inner {
    width: min(88rem, 100% - clamp(1.5rem, 5vw, 4rem));
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    padding-block: var(--space-xs);
  }

  .wordmark {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    justify-self: end;
  }

  .wordmark :global(.wordmark__img) {
    width: 160px;
    height: auto;
  }

  .nav-toggle {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--ink);
    cursor: pointer;
  }

  .nav-toggle[hidden] {
    display: none;
  }

  .nav-toggle__icon {
    display: grid;
    place-items: center;
  }

  .nav-toggle__icon :global(svg) {
    grid-area: 1 / 1;
  }

  :global(.nav-toggle__close),
  .site-header[data-nav-open='true'] :global(.nav-toggle__open) {
    display: none;
  }

  .site-header[data-nav-open='true'] :global(.nav-toggle__close) {
    display: block;
  }

  .site-header[data-nav-open='false'] .site-nav {
    display: none;
  }

  /* ---- Ausgeklapptes Panel (Burger-Menü) --------------------------------- */

  .site-nav {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-block: var(--space-xs) var(--space-sm);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    padding: var(--space-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header[data-nav-open='true'] .site-nav {
      animation: nav-in 0.28s var(--ease) both;
    }

    @keyframes nav-in {
      from {
        opacity: 0;
        translate: 0 -10px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }

  .site-nav ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: var(--tap);
    width: 100%;
    padding-inline: var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--step-base);
    font-weight: 600;
    text-decoration: none;
    color: var(--slate);
    white-space: nowrap;
  }

  .site-nav a:hover {
    background: var(--wash);
    color: var(--steel);
  }

  .site-nav a[aria-current] {
    background: var(--wash);
    color: var(--steel);
  }

  .site-nav :global(.site-nav__chevron) {
    color: var(--line-strong);
    flex: none;
  }

  .site-nav a:hover :global(.site-nav__chevron),
  .site-nav a[aria-current] :global(.site-nav__chevron) {
    color: var(--steel);
  }

  .site-nav__extra {
    border-top: 1px solid var(--line);
    margin-top: var(--space-2xs);
    padding-top: var(--space-2xs);
  }

  .site-nav__kontakt {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-sm);
    padding: var(--space-sm) var(--space-sm) var(--space-2xs);
    border-top: 1px solid var(--line);
  }

  .site-nav__kontakt a {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: auto;
    padding-inline: 0;
    gap: 0.45em;
    min-height: var(--tap);
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--soft);
    text-decoration: none;
  }

  .site-nav__kontakt a:hover {
    background: transparent;
  }

  .site-nav__kontakt a:hover {
    color: var(--steel);
  }

  .site-nav__kontakt :global(svg) {
    color: var(--steel);
  }

  .suche-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    color: var(--slate);
    background: transparent;
  }

  .suche-link:hover {
    border-color: var(--steel);
    color: var(--steel);
  }

  .site-header__cta {
    min-height: 40px;
    padding: 0.4rem 1.1rem;
    font-size: var(--step-small);
  }

  @media (max-width: 26rem) {
    .site-header__cta span {
      display: none;
    }

    .site-header__cta {
      width: var(--tap);
      padding-inline: 0;
    }
  }

  @media (min-width: 80rem) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto auto;
      gap: var(--space-sm);
    }

    .nav-toggle {
      display: none;
    }

    .site-nav {
      grid-column: 2;
      grid-row: 1;
      margin-block: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      justify-self: center;
      min-width: 0;
    }

    .site-nav :global(.site-nav__chevron),
    .site-nav__extra,
    .site-nav__kontakt {
      display: none;
    }

    .site-nav ul {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.25rem;
      background: var(--wash);
      border-radius: var(--radius-pill);
      padding: 0.3rem;
      width: max-content;
    }

    /* Menüpunkte dürfen nie umbrechen. */
    .site-nav a {
      width: auto;
      min-height: 38px;
      padding: 0 0.75rem;
      font-size: 0.875rem;
      justify-content: center;
      color: var(--soft);
      border-radius: var(--radius-pill);
      white-space: nowrap;
    }

    @media (prefers-reduced-motion: no-preference) {
      .site-nav a {
        transition:
          color var(--t-base) var(--ease),
          background-color var(--t-base) var(--ease);
      }
    }

    .site-nav a:hover {
      background: #fff;
      color: var(--ink);
    }

    .site-nav a[aria-current] {
      background: #fff;
      color: var(--steel);
      box-shadow: var(--shadow-soft);
    }
  }
</style>
