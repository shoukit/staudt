---
/**
 * Landingpage. Texte 1:1 der Vorlage; Reihenfolge behutsam korrigiert
 * (Hero mit H1 zuerst, dann Vorteile), eine primäre CTA (Anfrage).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KontaktBand from '../components/KontaktBand.astro';
import { branchen, broschuere, contact, hero, leistungen, services, site, ueberBand, vorteile } from '../data/site';

import fertigungshalle from '../assets/fertigungshalle.jpg';
import cncDrehen from '../assets/cnc-drehen.jpg';
import broschuereBild from '../assets/broschuere.jpg';

import iconExperten from '../assets/icon-experten.png';
import iconPraezision from '../assets/icon-praezision.png';
import iconZertifizierung from '../assets/icon-zertifizierung.png';
import iconQualitaet from '../assets/icon-qualitaet.png';
import iconReparatur from '../assets/icon-reparatur.png';
import iconArchiv from '../assets/icon-archiv.png';
import iconNeukonstruktion from '../assets/icon-neukonstruktion.png';
import iconLieferservice from '../assets/icon-lieferservice.png';

import fotoSerienfertigung from '../assets/slide-serienfertigung.jpg';
import fotoSonderloesungen from '../assets/slide-sonderloesungen.jpg';
import fotoHydraulikzylinder from '../assets/slide-hydraulikzylinder.jpg';

import fotoWindpark from '../assets/windpark.jpg';
import fotoPhotovoltaik from '../assets/photovoltaik.jpg';
import fotoWasserkraft from '../assets/wasserkraft.jpg';
import fotoArbeitsbuehnen from '../assets/arbeitsbuehnen.jpg';
import fotoGrosspressen from '../assets/grosspressen.jpg';

const icons: Record<string, ImageMetadata> = {
  'icon-experten': iconExperten,
  'icon-praezision': iconPraezision,
  'icon-zertifizierung': iconZertifizierung,
  'icon-qualitaet': iconQualitaet,
  'icon-reparatur': iconReparatur,
  'icon-archiv': iconArchiv,
  'icon-neukonstruktion': iconNeukonstruktion,
  'icon-lieferservice': iconLieferservice,
};

const leistungsFotos: Record<string, ImageMetadata> = {
  'slide-serienfertigung': fotoSerienfertigung,
  'slide-sonderloesungen': fotoSonderloesungen,
  'slide-hydraulikzylinder': fotoHydraulikzylinder,
};

const title = 'Staudt Hydraulik – Spezialist für Hydraulikzylinder | Geilenkirchen';
const description =
  'Staudt-Hydraulik GmbH & Co. KG: Hydraulikzylinder in Serien- und Sonderfertigung seit 1978. CNC-Fertigung, Montage und Prüfung in Deutschland – von der Beratung bis zur Auslieferung.';
---

<Base title={title} description={description}>
  <!-- ---- Hero ---------------------------------------------------------- -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{site.name} · seit 1978</p>
        <h1>{hero.h1}</h1>
        <p class="lead">{hero.sub}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/kontakt/">
            <Icon name="Mail" size={18} />
            Anfrage senden
          </a>
          <a class="btn btn--ghost" href="/wir-ueber-uns-2/">
            Über uns
            <Icon name="ArrowRight" size={16} />
          </a>
        </div>
        <ul class="hero__facts">
          <li><Icon name="Check" size={17} /> DIN EN ISO 9001:2015</li>
          <li><Icon name="Check" size={17} /> EN ISO 3834-3</li>
          <li><Icon name="Check" size={17} /> Fertigung in Deutschland</li>
        </ul>
      </div>
      <figure class="hero__figure">
        <Image
          src={fertigungshalle}
          alt="CNC-Fertigungshalle von Staudt Hydraulik"
          widths={[560, 800, 1100]}
          sizes="(min-width: 60rem) 48vw, 100vw"
          loading="eager"
          fetchpriority="high"
          quality={82}
          class="hero__img"
        />
      </figure>
    </div>
  </section>

  <!-- ---- Vorteile -------------------------------------------------------- -->
  <section class="band band--wash">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Ihre Vorteile</p>
        <h2>Vertrauen &amp; Qualität</h2>
      </div>
      <ul class="vorteile">
        {
          vorteile.map((v) => (
            <li class="vorteil" data-reveal>
              <Image
                src={icons[v.icon]!}
                alt=""
                widths={[120, 184]}
                sizes="92px"
                loading="lazy"
                quality={85}
                class="vorteil__icon"
              />
              <h3>{v.titel}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ---- Über Staudt ------------------------------------------------------ -->
  <section class="band">
    <div class="shell ueber">
      <figure class="ueber__figure" data-reveal>
        <Image
          src={cncDrehen}
          alt="CNC-Drehen bei Staudt Hydraulik"
          widths={[480, 720, 980]}
          sizes="(min-width: 60rem) 44vw, 100vw"
          loading="lazy"
          quality={82}
          class="ueber__img"
        />
      </figure>
      <div class="ueber__copy">
        <p class="eyebrow">{ueberBand.eyebrow}</p>
        <h2>{ueberBand.headline}</h2>
        <p class="ueber__kicker">{ueberBand.titel}</p>
        <p class="ueber__text">{ueberBand.text}</p>
        <a class="btn btn--ghost" href="/wir-ueber-uns-2/">
          Mehr über uns
          <Icon name="ArrowRight" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ---- Leistungen -------------------------------------------------------- -->
  <section class="band band--wash">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Leistungen</p>
        <h2>Was wir für Sie fertigen</h2>
      </div>
      <div class="lgrid">
        {
          leistungen.map((l) => (
            <a class="lcard" href={l.href} data-reveal>
              <Image
                src={leistungsFotos[l.foto]!}
                alt={l.fotoAlt}
                widths={[420, 640, 900]}
                sizes="(min-width: 48rem) 33vw, 100vw"
                loading="lazy"
                quality={80}
                class="lcard__img"
              />
              <span class="lcard__body">
                <span class="lcard__title">{l.titel}</span>
                <span class="lcard__text">{l.text}</span>
                <span class="lcard__more">
                  Mehr erfahren
                  <Icon name="ArrowRight" size={16} />
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---- Branchen ----------------------------------------------------------- -->
  <section class="band band--slate">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">{branchen.eyebrow}</p>
        <h2>{branchen.headline}</h2>
        <p class="branchen__sub">{branchen.titel}</p>
      </div>
      <div class="branchen">
        <div class="branchen__copy" data-reveal>
          <p>{branchen.text}</p>
          <ul class="branchen__liste">
            {
              branchen.liste.map((b) => (
                <li>
                  <Icon name="Check" size={16} />
                  {b}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="branchen__fotos" data-reveal>
          <figure>
            <Image src={fotoWindpark} alt="Windpark Offshore" widths={[300, 460]} sizes="(min-width: 60rem) 15vw, 45vw" loading="lazy" quality={78} />
            <figcaption>Windenergie</figcaption>
          </figure>
          <figure>
            <Image src={fotoPhotovoltaik} alt="Photovoltaik-Anlage" widths={[300, 460]} sizes="(min-width: 60rem) 15vw, 45vw" loading="lazy" quality={78} />
            <figcaption>Photovoltaik</figcaption>
          </figure>
          <figure>
            <Image src={fotoWasserkraft} alt="Wasserkraftwerk" widths={[300, 460]} sizes="(min-width: 60rem) 15vw, 45vw" loading="lazy" quality={78} />
            <figcaption>Wasserkraft</figcaption>
          </figure>
          <figure class="branchen__wide">
            <Image src={fotoArbeitsbuehnen} alt="Arbeitsbühnen" widths={[420, 640]} sizes="(min-width: 60rem) 23vw, 45vw" loading="lazy" quality={78} />
            <figcaption>Arbeitsbühnen</figcaption>
          </figure>
          <figure class="branchen__wide">
            <Image src={fotoGrosspressen} alt="Großpressen im Karosseriebau" widths={[420, 640]} sizes="(min-width: 60rem) 23vw, 45vw" loading="lazy" quality={78} />
            <figcaption>Großpressen / Karosseriebau</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ---- Service -------------------------------------------------------------- -->
  <section class="band">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Service</p>
        <h2>Unser besonderer Kundenservice für Sie</h2>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <div class="service" data-reveal>
              <Image
                src={icons[s.icon]!}
                alt=""
                widths={[100, 160]}
                sizes="80px"
                loading="lazy"
                quality={85}
                class="service__icon"
              />
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </div>
          ))
        }
      </div>
      <a
        class="broschuere-band"
        href="https://www.flipsnack.com/679AE87A9F7/staudt-hydraulik-broschu-re"
        rel="noopener"
        target="_blank"
        data-reveal
      >
        <Image
          src={broschuereBild}
          alt="Titelseite der Staudt-Hydraulik-Broschüre"
          widths={[220, 400]}
          sizes="(min-width: 48rem) 190px, 55vw"
          loading="lazy"
          quality={80}
          class="broschuere-band__cover"
        />
        <div class="broschuere-band__body">
          <h3>{broschuere.titel}</h3>
          <p>{broschuere.text}</p>
          <span class="service__more">
            Hier ansehen
            <Icon name="ArrowUpRight" size={16} />
          </span>
        </div>
      </a>
    </div>
  </section>

  <KontaktBand />
</Base>

<style>
  /* ---- Hero ---------------------------------------------------------------- */

  .hero {
    background:
      radial-gradient(70% 90% at 100% 0%, #dde9f5 0%, transparent 55%),
      linear-gradient(175deg, var(--wash) 0%, var(--paper) 72%);
    padding-block: var(--space-xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .hero__copy h1 {
    font-size: clamp(2.3rem, 1.7rem + 2.8vw, 3.9rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--soft);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.4em;
  }

  .hero__facts :global(svg) {
    color: var(--steel);
  }

  .hero__figure {
    margin: 0;
  }

  .hero :global(.hero__img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  @media (min-width: 60rem) {
    .hero {
      padding-block: var(--space-2xl);
    }

    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__copy {
      animation: hero-in 0.7s var(--ease) both;
    }

    :global(html.js) .hero__figure {
      animation: hero-in 0.7s var(--ease) 0.12s both;
    }

    @keyframes hero-in {
      from {
        opacity: 0;
        translate: 0 24px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }

  /* ---- Vorteile -------------------------------------------------------------- */

  .vorteile {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .vorteil {
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    align-content: start;
  }

  .vorteil :global(.vorteil__icon) {
    width: 92px;
    height: 92px;
    margin-bottom: var(--space-xs);
  }

  .vorteil p {
    color: var(--soft);
    font-size: var(--step-small);
  }

  @media (min-width: 40rem) {
    .vorteile {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .vorteile {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---- Über Staudt ------------------------------------------------------------ */

  .ueber {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .ueber__figure {
    margin: 0;
  }

  .ueber :global(.ueber__img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    width: 100%;
  }

  .ueber__copy {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .ueber__kicker {
    font-weight: 600;
    color: var(--steel);
  }

  .ueber__text {
    color: var(--soft);
  }

  @media (min-width: 60rem) {
    .ueber {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  /* ---- Leistungen --------------------------------------------------------------- */

  .lgrid {
    display: grid;
    gap: var(--space-md);
  }

  .lcard {
    display: grid;
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: clip;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
  }

  .lcard :global(.lcard__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .lcard__body {
    display: grid;
    gap: 0.35rem;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    align-content: start;
  }

  .lcard__title {
    font-weight: 650;
    font-size: 1.25rem;
    color: var(--slate);
    letter-spacing: -0.01em;
  }

  .lcard__text {
    color: var(--soft);
    font-size: var(--step-small);
  }

  .lcard__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-sm);
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--steel);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lcard {
      transition: box-shadow var(--t-base) var(--ease), transform var(--t-base) var(--ease);
    }

    .lcard:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }

    .lcard :global(.lcard__img) {
      transition: scale var(--t-slow) var(--ease);
    }

    .lcard:hover :global(.lcard__img) {
      scale: 1.04;
    }
  }

  @media (min-width: 48rem) {
    .lgrid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ---- Branchen -------------------------------------------------------------------- */

  .branchen__sub {
    color: #dbe3ea;
    font-weight: 600;
  }

  .branchen {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .branchen__copy {
    display: grid;
    gap: var(--space-md);
  }

  .branchen__copy > p {
    color: #dbe3ea;
    max-width: 60ch;
  }

  .branchen__liste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-xs) var(--space-md);
    font-size: var(--step-small);
  }

  .branchen__liste li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: #fff;
    min-height: 28px;
  }

  .branchen__liste :global(svg) {
    color: #9ec2e8;
    flex: none;
  }

  .branchen__fotos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .branchen__fotos figure {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .branchen__fotos :global(img) {
    border-radius: var(--radius-sm);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    width: 100%;
  }

  .branchen__wide :global(img) {
    aspect-ratio: 16 / 10;
  }

  .branchen__fotos figcaption {
    font-size: 0.8125rem;
    color: #b9c6d2;
  }

  @media (min-width: 60rem) {
    .branchen {
      grid-template-columns: 1fr 1fr;
    }

    .branchen__fotos {
      grid-template-columns: repeat(3, 1fr);
    }

    .branchen__wide:nth-of-type(4) {
      grid-column: 1 / span 2;
    }

    .branchen__wide:nth-of-type(5) {
      grid-column: 3;
    }

    .branchen__wide:nth-of-type(5) :global(img) {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  /* ---- Service ---------------------------------------------------------------------- */

  .services {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  .service {
    background: var(--wash);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    align-content: start;
    text-decoration: none;
  }

  .service :global(.service__icon) {
    width: 80px;
    height: 80px;
    margin-bottom: var(--space-xs);
  }

  .service p {
    color: var(--soft);
    font-size: var(--step-small);
  }

  /* Broschüre: liegende Karte unter dem Service-Raster */
  .broschuere-band {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    align-items: center;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
  }

  .broschuere-band :global(.broschuere-band__cover) {
    width: 100%;
    max-width: 190px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
  }

  .broschuere-band__body {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .broschuere-band__body p {
    color: var(--soft);
    max-width: 62ch;
  }

  .service__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--steel);
  }

  @media (prefers-reduced-motion: no-preference) {
    .broschuere-band {
      transition: box-shadow var(--t-base) var(--ease), transform var(--t-base) var(--ease);
    }

    .broschuere-band:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lift);
    }
  }

  @media (min-width: 48rem) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }

    .broschuere-band {
      grid-template-columns: auto 1fr;
      gap: var(--space-xl);
      padding-inline: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    .services {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
