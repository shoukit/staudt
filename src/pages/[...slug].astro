---
/**
 * Produkt-Detailseiten an den Original-Slugs. Beschreibungen und technische
 * Daten wörtlich 1:1 von der Vorlage (siehe src/data/produkte.ts). Technische
 * Zeichnung als Band: schwarz für helle Linien, hell für dunkle (grafikHell).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KontaktBand from '../components/KontaktBand.astro';
import PageHero from '../components/PageHero.astro';
import { produkte } from '../data/produkte';
import { contact } from '../data/site';

export function getStaticPaths() {
  return produkte.map((p) => ({ params: { slug: p.slug }, props: { produkt: p } }));
}

const alleBilder = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{jpg,jpeg,png}',
  { eager: true }
);

const bild = (name: string): ImageMetadata => {
  for (const [pfad, mod] of Object.entries(alleBilder)) {
    const basis = pfad.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '');
    if (basis === name) return mod.default;
  }
  throw new Error(`Bild "${name}" nicht in src/assets gefunden`);
};

const { produkt } = Astro.props;
const idx = produkte.findIndex((p) => p.slug === produkt.slug);
const vorher = idx > 0 ? produkte[idx - 1] : undefined;
const nachher = idx < produkte.length - 1 ? produkte[idx + 1] : undefined;

const title = `${produkt.kategorie} – Staudt Hydraulik`;
const description = `${produkt.titel}${produkt.untertitel ? ` ${produkt.untertitel}` : ''} – ${produkt.kategorie} aus der Fertigung von Staudt Hydraulik, Geilenkirchen.`;

const anfrageMailto =
  `${contact.emailHref}?subject=${encodeURIComponent(`Anfrage: ${produkt.kategorie}`)}`;
---

<Base title={title} description={description}>
  <PageHero eyebrow={`Referenzprodukt ${produkt.nr}`} titel={produkt.kategorie}>
    <nav class="crumbs" aria-label="Pfad" slot="top">
      <a href="/hydraulikzylinder/">Hydraulikzylinder</a>
      <Icon name="ChevronRight" size={14} />
      <span aria-current="page">{produkt.nr} · {produkt.kategorie}</span>
    </nav>
  </PageHero>

  <div class="grafikband">
    <div class="shell">
      <Image
        src={bild(produkt.grafik)}
        alt={produkt.grafikAlt}
        widths={[768, 1200, 1800]}
        sizes="(min-width: 64rem) 72rem, 100vw"
        loading="eager"
        fetchpriority="high"
        quality={85}
        class="grafikband__img"
      />
    </div>
  </div>

  <section class="band">
    <div class="shell produkt">
      <figure class="produkt__figure" data-reveal>
        <Image
          src={bild(produkt.foto)}
          alt={produkt.fotoAlt}
          widths={[480, 720, 980]}
          sizes="(min-width: 60rem) 42vw, 100vw"
          loading="lazy"
          quality={82}
          class="produkt__img"
        />
      </figure>

      <div class="produkt__copy">
        <h2>{produkt.titel}</h2>
        {produkt.untertitel && <p class="produkt__unter">{produkt.untertitel}</p>}
        {
          produkt.absaetze && (
            <div class="prose">
              {produkt.absaetze.map((a) => (
                <p>{a}</p>
              ))}
            </div>
          )
        }

        {
          produkt.daten.length > 0 && (
            <div class="daten" data-reveal>
              <p class="daten__label">Technische Daten</p>
              {produkt.daten.map((gruppe, gi) => (
                <table class="daten__tabelle">
                  {produkt.datenGruppen && <caption>{produkt.datenGruppen[gi]}</caption>}
                  <tbody>
                    {gruppe.map((d) => (
                      <tr>
                        <th scope="row">{d.label}</th>
                        <td>{d.wert}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              ))}
            </div>
          )
        }

        {produkt.hinweis && <p class="produkt__hinweis">{produkt.hinweis}</p>}

        <a class="btn btn--primary" href={anfrageMailto}>
          <Icon name="Mail" size={18} />
          Anfragen
        </a>
      </div>
    </div>
  </section>

  <section class="band band--wash">
    <div class="shell weitere">
      <h2>Weitere Referenzprodukte</h2>
      <ul>
        {
          vorher && (
            <li>
              <a href={`/${vorher.slug}/`}>
                <Icon name="ArrowRight" size={16} class="weitere__zurueck" />
                {vorher.nr} · {vorher.kategorie}
              </a>
            </li>
          )
        }
        {
          nachher && (
            <li>
              <a href={`/${nachher.slug}/`}>
                {nachher.nr} · {nachher.kategorie}
                <Icon name="ArrowRight" size={16} />
              </a>
            </li>
          )
        }
        <li>
          <a href="/hydraulikzylinder/">
            Alle Hydraulikzylinder
            <Icon name="ArrowRight" size={16} />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <KontaktBand />
</Base>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em;
    font-size: var(--step-small);
    color: var(--soft);
  }

  .crumbs a {
    color: var(--steel);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .crumbs :global(svg) {
    color: var(--line-strong);
    flex: none;
  }

  /* Technische Zeichnung als helles Band (Kundenwunsch: nicht dunkel);
     Zeichnungen mit hellen Linien sind dafür invertiert. */
  .grafikband {
    background: var(--wash);
    border-block: 1px solid var(--line);
    padding-block: var(--space-lg);
  }

  .grafikband :global(.grafikband__img) {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
  }

  .produkt {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  .produkt__figure {
    margin: 0;
  }

  .produkt :global(.produkt__img) {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    width: 100%;
    background: #fff;
  }

  .produkt__copy {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .produkt__unter {
    color: var(--soft);
    font-size: 1.125rem;
  }

  .produkt__hinweis {
    color: var(--soft);
    background: var(--wash);
    border-left: 4px solid var(--steel);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--step-small);
  }

  .daten {
    width: 100%;
    background: var(--wash);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-md);
    margin-block: var(--space-sm);
  }

  .daten__label {
    font-size: var(--step-eyebrow);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--steel);
  }

  .daten__tabelle {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step-small);
  }

  .daten__tabelle caption {
    text-align: left;
    font-weight: 650;
    color: var(--slate);
    padding-bottom: 0.35rem;
  }

  .daten__tabelle th {
    text-align: left;
    font-weight: 500;
    color: var(--soft);
    padding: 0.45rem 0.75rem 0.45rem 0;
    width: 42%;
    vertical-align: top;
  }

  .daten__tabelle td {
    font-weight: 650;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    padding: 0.45rem 0;
  }

  .daten__tabelle tr + tr th,
  .daten__tabelle tr + tr td {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .produkt {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .produkt__figure {
      position: sticky;
      top: 6rem;
    }
  }

  .weitere {
    display: grid;
    gap: var(--space-md);
  }

  .weitere ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .weitere a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: var(--tap);
    padding: 0.5rem 1.25rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: var(--step-small);
    color: var(--steel);
    text-decoration: none;
  }

  .weitere a:hover {
    border-color: var(--steel);
  }

  .weitere :global(.weitere__zurueck) {
    rotate: 180deg;
  }
</style>
