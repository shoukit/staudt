---
/**
 * Branchen & Referenzen — die fünf Kacheln der Vorlage mit deren
 * Original-PNGs, Text 1:1.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KontaktBand from '../components/KontaktBand.astro';
import PageHero from '../components/PageHero.astro';
import { branchenReferenzen, contact } from '../data/site';

const alleBilder = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{jpg,jpeg,png}',
  { eager: true }
);

const bild = (name: string): ImageMetadata => {
  for (const [pfad, mod] of Object.entries(alleBilder)) {
    const basis = pfad.split('/').pop()!.replace(/\.(jpg|jpeg|png)$/, '');
    if (basis === name) return mod.default;
  }
  throw new Error(`Bild "${name}" nicht in src/assets gefunden`);
};

const title = 'Branchen & Referenzen – Staudt Hydraulik';
const description =
  'Branchen und Referenzen von Staudt Hydraulik: Photovoltaik, On- & Offshore-Windenergie, Wasserkraft, Pressen und Arbeitsbühnen.';
---

<Base title={title} description={description}>
  <PageHero
    eyebrow="Referenzen"
    titel={branchenReferenzen.h1}
    lead={branchenReferenzen.intro}
    bild="header-branchen-neu-foto"
    bildAlt="CNC-Bearbeitung eines Zylinderbauteils mit Kühlmittel"
  />

  <section class="band band--wash">
    <div class="shell">
      <ul class="kacheln">
        {
          branchenReferenzen.kacheln.map((k) => (
            <li class="kachel" data-reveal>
              <Image
                src={bild(k.bild)}
                alt={k.titel}
                widths={[420, 640, 900]}
                sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 44vw, 90vw"
                loading="lazy"
                quality={80}
                class="kachel__img"
              />
              <div class="kachel__body">
                <h2>{k.titel}</h2>
                <a
                  class="btn btn--ghost kachel__btn"
                  href={`${contact.emailHref}?subject=${encodeURIComponent(`Anfrage: ${k.titel}`)}`}
                >
                  <Icon name="Mail" size={16} />
                  Anfragen
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <KontaktBand />
</Base>

<style>
  .kacheln {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .kachel {
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: clip;
    box-shadow: var(--shadow-soft);
    display: grid;
  }

  .kachel :global(.kachel__img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .kachel__body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
  }

  .kachel__body h2 {
    font-size: 1.25rem;
  }

  .kachel__btn {
    min-height: 40px;
    padding: 0.35rem 1.1rem;
    font-size: var(--step-small);
  }

  @media (min-width: 40rem) {
    .kacheln {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .kacheln {
      grid-template-columns: repeat(3, 1fr);
    }

    .kachel:nth-child(4),
    .kachel:nth-child(5) {
      grid-column: span 1;
    }
  }
</style>
